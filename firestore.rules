rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules.
// Each signed-in user can only read and add their own game history.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/games/{gameId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.outcome in ['win', 'loss', 'draw']
        && request.resource.data.ourScore is int && request.resource.data.theirScore is int
        && request.resource.data.mode in ['online', 'local', 'ai'];
      allow update, delete: if false;
    }
  }
}
